# Deployment remains in review mode by default. This blocks indexing and must
# stay as "review" until the institution approves a public production release.
NEXT_PUBLIC_SITE_MODE=review

# Optional absolute URL for a Vercel review deployment. Set this in Vercel only
# after the requested subdomain has been assigned; do not set the official
# domain here without explicit approval.
NEXT_PUBLIC_SITE_URL=

# The public form remains disabled until all values below exist in the production environment
# and src/config/contact-form.ts has an approved https privacyPolicyUrl and approval flag.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
RESEND_API_KEY=

# Shared rate limit required for serverless production (Upstash Redis REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
