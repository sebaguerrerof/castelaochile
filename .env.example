# Public Supabase values (safe to expose to the browser)
# Target project: rybcqiuklmoxhcostmlf
NEXT_PUBLIC_SUPABASE_URL=https://rybcqiuklmoxhcostmlf.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Editorial source used only by the server-side blog synchronization command.
CASTELAO_SOURCE_BASE_URL=https://www.institutocastelao.com

# Site and deployment mode
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_MODE=review

# Public contact intake: leave every gate false/empty until legal approval.
CONTACT_INTAKE_ENABLED=false
CONTACT_PRIVACY_POLICY_APPROVED=false
CONTACT_PRIVACY_POLICY_URL=
CONTACT_PRIVACY_CONSENT_LABEL=

# First-party analytics: consent is mandatory. Collection only on the canonical production URL.
# Independent of NEXT_PUBLIC_SITE_MODE (SEO review mode can remain enabled).
ANALYTICS_ENABLED=false

# Shared rate limiting required by contact intake and analytics when enabled.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Existing optional provider values; contact persistence does not depend on email delivery.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
